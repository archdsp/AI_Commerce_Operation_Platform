# AI Commerce Operations Platform — copy to .env and edit
# 실제 스택: RDS MySQL(시드니) + MSK(서울, IAM) + 셀프호스트 Qdrant + RunPod vLLM
# See docs/DEPLOYMENT.md, PROGRESS.md  (비밀값은 .gitignore)

# === Application ===
APP_ENV=development
LOG_LEVEL=INFO
SIM_TODAY=2026-05-31
SIM_TZ=America/Sao_Paulo
# APP_LOG_DIR=/workspace/app_logs        # 미설정 시 기본 /workspace/app_logs

# === Gateway (FastAPI) ===
# AWS API Gateway 우회 직접호출 차단용 공유 시크릿 (REST API가 X-Origin-Secret 헤더로 주입). 미설정 시 검증 생략(로컬)
GATEWAY_ORIGIN_SECRET=

# === RDS MySQL (ap-southeast-2) ===
MYSQL_HOST=your-rds.xxxxxxxx.ap-southeast-2.rds.amazonaws.com
MYSQL_PORT=3306
MYSQL_USER=admin
MYSQL_PASSWORD=change-me
MYSQL_DB_OLIST=olist_raw
MYSQL_DB_OPS=commerce_ops

# === MSK Kafka (IAM, ap-northeast-2) ===
AWS_REGION=ap-northeast-2
KAFKA_BOOTSTRAP_SERVERS=boot-xxxxxxxx.c2.kafka-serverless.ap-northeast-2.amazonaws.com:9098
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_ORDER_EVENTS_TOPIC=order_events
KAFKA_REVIEW_CREATED_TOPIC=review_created
KAFKA_REVIEW_ANALYZED_TOPIC=review_analyzed
KAFKA_METRIC_UPDATED_TOPIC=metric_updated
# KAFKA_REPLICATION=1

# === Qdrant (셀프호스트) ===
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=reviews

# === vLLM (RunPod, OpenAI 호환) ===
# RunPod 프록시는 Cloudflare 뒤 → src/common/llm.py 가 브라우저 UA 강제 (error 1010 회피)
VLLM_URL=https://xxxxxxxx.proxy.runpod.net
VLLM_API_KEY=
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# === Simulator (scripts/run.py) — docs/setup/05_edge_simulator.md ===
TAF=1
SYNTH_REPLICATION=1
BASE_NODES=636
OLIST_DATA_DIR=./data/olist

# === (선택) 로컬 PG 시뮬레이터 스캐폴딩 — scripts/setup_db.sh 전용. 운영은 위 RDS MySQL 사용 ===
# PGHOST=localhost
# PGPORT=5432
# PGUSER=commerce
# PGPASSWORD=change-me
# OLIST_DB=olist_raw
