# ── 로컬 실행 프로파일 (macOS · Linux · WSL Ubuntu · Windows) ───────────────
# AWS 없이 docker-compose.local.yml(MySQL·Redpanda·Qdrant) + Ollama로 전 구간 구동.
#   cp .env.local.example .env.local   후 scripts/local/up.sh
# 앱은 ENV_FILE=.env.local 일 때 이 파일을 우선 로드한다(기존 .env=운영은 그대로).
# See docs/LOCAL.md

# === Application ===
APP_ENV=local
LOG_LEVEL=INFO
SIM_TODAY=2026-05-31
SIM_TZ=America/Sao_Paulo

# === Gateway (FastAPI) ===
# 로컬은 API Gateway 우회 검증 불필요 → 빈값(미설정 시 검증 생략)
GATEWAY_ORIGIN_SECRET=
GW_PORT=8000

# === MySQL (docker-compose.local.yml: mysql:8.4) ===
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=localdev
MYSQL_DB_OLIST=olist_raw
MYSQL_DB_OPS=commerce_ops

# === Kafka (docker-compose.local.yml: redpanda, PLAINTEXT) ===
AWS_REGION=ap-northeast-2          # 로컬 PLAINTEXT에선 미사용(IAM 서명 없음)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_REPLICATION=1                # 단일 노드 → RF=1
KAFKA_ORDER_EVENTS_TOPIC=order_events
KAFKA_REVIEW_CREATED_TOPIC=review_created
KAFKA_REVIEW_ANALYZED_TOPIC=review_analyzed
KAFKA_METRIC_UPDATED_TOPIC=metric_updated

# === Qdrant (docker-compose.local.yml: qdrant) ===
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                    # 로컬은 키 없음
QDRANT_COLLECTION=reviews

# === LLM (Ollama, OpenAI 호환) ===
# Ollama가 /v1/chat/completions 를 제공 → common/llm.py 가 그대로 호출(브라우저 UA·빈 키 무해).
# Apple Silicon=Metal, NVIDIA(RTX 4070 Ti 등)=CUDA 가속. 7b는 ~4.7GB.
VLLM_URL=http://localhost:11434
VLLM_API_KEY=
VLLM_MODEL=qwen2.5:7b              # 저사양: qwen2.5:3b / qwen2.5:1.5b

# === Simulator ===
TAF=1
SYNTH_REPLICATION=1
BASE_NODES=636
OLIST_DATA_DIR=./data/olist_sample   # 커밋된 자급형 샘플(전체는 풀 Olist 디렉터리로 교체)
